# Existing application PostgreSQL connection. For Neon, keep sslmode=require.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Isolated local PostgreSQL used by integration tests (docker compose).
TEST_DATABASE_URL=postgresql://pricelens:pricelens_local@localhost:5433/pricelens

# Provider credentials. Never commit real values.
SERPAPI_API_KEY=
APIFY_API_TOKEN=

# India-only market discovery.
MARKET_COUNTRY=in
MARKET_GOOGLE_DOMAIN=google.co.in
MARKET_AMAZON_DOMAIN=amazon.in

# SerpAPI resilience. Amazon Product API enrichment stays optional; discovery
# always uses Amazon Search plus Google Shopping.
SERPAPI_CONNECT_TIMEOUT=10
SERPAPI_READ_TIMEOUT=120
SERPAPI_RETRIES=2
SERPAPI_ENRICH_AMAZON=false

# Apify two-stage discovery and seller/promotion enrichment.
APIFY_ECOM_ACTOR=apify/e-commerce-scraping-tool
APIFY_ECOM_MODE=Sellers
APIFY_FLIPKART_DETAILS_ACTOR=piotrv1001/flipkart-product-details-scraper
APIFY_BANK_OFFERS_ACTOR=pale_tapestry/bank-offers-aggregator-actor
APIFY_ENRICHERS=flipkart_details,bank_offers
APIFY_ENRICH_LIMIT=5
# APIFY_EXTRA_INPUT_JSON={"bank_offers":{"useProxy":true}}
GEMINI_API_KEY=

# Eligibility & Safety Agent (policy RAG + seller/stock check).
# Embeddings: local (bundled MiniLM, downloads once), gateway (OpenAI-compatible
# LLM_BASE_URL endpoint, model POLICY_EMBEDDING_MODEL) or hash (offline keywords).
POLICY_EMBEDDINGS=local
# POLICY_EMBEDDING_MODEL=text-embedding-3-small
# POLICY_CHROMA_DIR=data/chroma
# POLICY_MIN_RELEVANCE=0.25
POLICY_LLM_TIMEOUT=30
# Comma-separated seller names you consider authorised (case-insensitive substring).
TRUSTED_SELLERS=
OFFER_STALE_HOURS=24
